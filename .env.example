# Required for the proxy + certbot setup.
DOMAIN=mts.example.com
CERTBOT_EMAIL=you@example.com

# Override DB credentials (defaults to postgres/postgres/mts).
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=mts

# Frontend build-time vars baked into the image.
# Default '/api' uses the same-origin proxy route — no need to override.
# VITE_API_URL=/api
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
